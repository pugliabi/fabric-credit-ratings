# Used by the local rating desk (npm run desk). Never needed in GitHub.

# Your GitHub username. Your desk scores are saved as src/data/rounds/<round>/scores/<RATER>.json.
RATER=

# Drafts "Why this rating" text in the desk.
ANTHROPIC_API_KEY=
# Required when the key is not scoped to a workspace (Claude Console, Settings, Workspaces).
ANTHROPIC_WORKSPACE_ID=
# Optional. Defaults to claude-sonnet-5-5.
ANTHROPIC_MODEL=
