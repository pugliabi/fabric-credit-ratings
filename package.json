{
  "name": "fabric-credit-ratings",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "desk": "vite --open /desk.html",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc && tsc -p scripts && tsc -p api",
